{
  "name": "steadyframe-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SteadyFrame frontend: checks video against published photosensitivity thresholds (WCAG 2.3.1, ITU-R BT.1702 / Ofcom guidance) and shows the remediation trace.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/cli": "4.13.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6"
  },
  "overrides": {
    "chromedriver": "141.0.6"
  },
  "engines": {
    "node": ">=22"
  }
}
