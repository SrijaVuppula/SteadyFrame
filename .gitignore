# python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.hypothesis/
.ruff_cache/
build/
dist/

# generated media - never commit hazardous clips (see docs/STANDARDS.md and data/synthetic/WARNING.md)
data/synthetic/**
!data/synthetic/WARNING.md
!data/synthetic/.gitkeep
data/real/**
!data/real/README.md
*.mp4
*.avi
*.mov
*.gif
*.mkv

# eval / bench outputs are regenerated by make eval / make bench; the frozen copies live in eval/results/frozen
eval/results/*
!eval/results/frozen/
!eval/results/frozen/**
bench/results/*
!bench/results/.gitkeep

# node
web/node_modules/
web/dist/

# infra
infra/cdk.out/
infra/.cdk.staging/

# misc
.DS_Store
.env
*.log
/tmp/
bench/clips/
